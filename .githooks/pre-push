#!/bin/sh
# Corre en local la misma tanda que ejecuta el workflow CI antes de dejar
# salir el push. Evita el fallo recurrente: se edita contenido, el manifiesto
# de hashes queda desfasado y los 9 jobs de la matriz caen en rojo.
#
# Instalar:  make hooks
# Saltar:    git push --no-verify   (solo si sabes por qué)

set -e

echo "pre-push: replicando la tanda de CI..."

python -m unittest discover -s tests
python scripts/validate_repository.py --strict >/dev/null
python scripts/generate_papers.py --check
python scripts/link_papers_to_classes.py --check
python -m compileall -q src scripts classes apps

echo "pre-push: todo en verde, empujando."
